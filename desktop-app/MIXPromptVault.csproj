<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>MIX-Prompt-Vault</AssemblyName>
    <RootNamespace>MIXPromptVault</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>MIX Image Prompt Archive</AssemblyTitle>
    <Product>MIX Image Prompt Archive</Product>
    <Company>MIX-IMAGE Art &amp; Audio</Company>
    <Description>คลังรวมพรอมต์ AI ส่วนตัว — MIX-IMAGE</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
